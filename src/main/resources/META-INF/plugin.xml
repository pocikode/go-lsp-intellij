<idea-plugin>
    <id>com.github.pocikode.go_lsp_intellij</id>
    <name>Go LSP</name>
    <vendor url="https://github.com/pocikode/go-lsp-intellij">Go LSP contributors</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!--
        The IntelliJ LSP API ships in the IntelliJ IDEA (Ultimate) distribution and, since 2025.2,
        works without a paid license. The dependency is optional so the plugin still installs in
        builds without the module (Community 2025.2, Android Studio); format-on-save and the local
        Go runners still work there. Everything that touches com.intellij.platform.lsp lives in
        go-lsp.xml.
    -->
    <depends optional="true" config-file="go-lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.pocikode.go_lsp_intellij.GoLspSettingsState" />
        <projectService serviceImplementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSaveState" />
        <applicationConfigurable parentId="tools" displayName="Go LSP"
                                 id="com.github.pocikode.go_lsp_intellij.GoLspConfigurable"
                                 instance="com.github.pocikode.go_lsp_intellij.GoLspConfigurable" />
        <actionOnSaveInfoProvider id="GoLspFormatOnSaveInfoProvider"
                                   implementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSaveInfoProvider" />
        <actionOnSave id="GoLspFormatOnSave"
                       implementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSave" />
        <notificationGroup id="Go LSP" displayType="BALLOON" />
        <!-- Go files are handled by the bundled TextMate grammar, whose icon does not look like
             GoLand's; this restores a Go icon in the project view and editor tabs. -->
        <fileIconProvider implementation="com.github.pocikode.go_lsp_intellij.GoLspFileIconProvider" />
        <!--
            GoLand's Go colour keys carry explicit values for these two scheme families that no
            fallback key reproduces; without them package qualifiers and type references come out
            plain here while GoLand shows them olive and teal. A scheme that names a key itself
            still wins over these defaults. See GoLspSemanticTokens.
        -->
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/GoLspDarcula.xml" />
        <additionalTextAttributes scheme="IntelliJ Light" file="colorSchemes/GoLspLight.xml" />
        <!--
            Struct tag keys, which GoLand paints apart from the rest of the raw string. Registered
            for the TextMate language because that is what claims .go files without the native Go
            plugin; with that plugin loaded the files are not TextMate and this never runs.
        -->
        <annotator language="textmate"
                   implementationClass="com.github.pocikode.go_lsp_intellij.GoLspStructTagAnnotator" />
        <!--
            GoLand's Add key to tags intention has no gopls equivalent. It parses fields from text
            because the bundled TextMate grammar gives a Go file one PSI leaf.
        -->
        <intentionAction>
            <language>textmate</language>
            <category>Go</category>
            <className>com.github.pocikode.go_lsp_intellij.GoAddKeyToTagsIntention</className>
        </intentionAction>
        <!--
            gopls does not complete struct tag keys. This contributor reads the original document
            because TextMate presents a Go file as one PSI leaf, and opens automatically after ``.
        -->
        <completion.contributor id="GoStructTagCompletionContributor"
                                language="textmate"
                                implementationClass="com.github.pocikode.go_lsp_intellij.GoStructTagCompletionContributor"
                                order="first" />
        <typedHandler implementation="com.github.pocikode.go_lsp_intellij.GoStructTagCompletionAutoPopup" />
        <completion.confidence language="textmate"
                               implementationClass="com.github.pocikode.go_lsp_intellij.GoStructTagCompletionConfidence" />
        <!--
            TextMate indexes TODO words as candidates but exposes an empty PSI lexer, so the TODO
            tool window cannot recover exact items or navigate them. This Go-only lexer contributes
            real comment ranges; `order="last"` makes it win over TextMate's empty builder.
        -->
        <indexPatternBuilder implementation="com.github.pocikode.go_lsp_intellij.GoTodoPatternBuilder"
                             order="last" />
        <!--
            Makes *_test.go a member of the platform's built-in "Tests" scope, which File Colors
            already paints green; Go has no test source root for the platform to find by itself.
        -->
        <testSourcesFilter implementation="com.github.pocikode.go_lsp_intellij.GoLspTestSourcesFilter" />
        <!--
            Running Go programs and tests. None of this needs com.intellij.platform.lsp: declarations
            come from the file's own text, programs use `go run`, and the test tree comes from
            `go test -json`. Keep all of it registered here.
        -->
        <configurationType implementation="com.github.pocikode.go_lsp_intellij.GoRunConfigurationType" />
        <configurationType implementation="com.github.pocikode.go_lsp_intellij.GoTestRunConfigurationType" />
        <!--
            The green run arrows. A runLineMarkerContributor would be the usual extension point, but
            it is offered PSI elements to recognise and a TextMate .go file is a single leaf; this
            provider places its markers by offset instead. Registered for the TextMate language
            because that is what claims .go files without the native Go plugin.
        -->
        <codeInsight.lineMarkerProvider language="textmate"
                                         implementationClass="com.github.pocikode.go_lsp_intellij.GoTestLineMarkerProvider" />
        <codeInsight.lineMarkerProvider language="textmate"
                                         implementationClass="com.github.pocikode.go_lsp_intellij.GoMainLineMarkerProvider" />
        <!-- Turns the foo_test.go:12 prefix of a test failure into a link to that line. -->
        <consoleFilterProvider implementation="com.github.pocikode.go_lsp_intellij.GoTestConsoleFilterProvider" />
    </extensions>
</idea-plugin>
