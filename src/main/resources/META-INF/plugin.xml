<idea-plugin>
    <id>com.github.pocikode.go_lsp_intellij</id>
    <name>Go LSP</name>
    <vendor url="https://github.com/pocikode/go-lsp-intellij">Go LSP contributors</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!--
        The IntelliJ LSP API ships in the IntelliJ IDEA (Ultimate) distribution and, since 2025.2,
        works without a paid license. The dependency is optional so the plugin still installs in
        builds without the module (Community 2025.2, Android Studio); only the gofmt/goimports
        format-on-save action works there. Everything that touches com.intellij.platform.lsp lives
        in go-lsp.xml.
    -->
    <depends optional="true" config-file="go-lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.pocikode.go_lsp_intellij.GoLspSettingsState" />
        <projectService serviceImplementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSaveState" />
        <applicationConfigurable parentId="tools" displayName="Go LSP"
                                 id="com.github.pocikode.go_lsp_intellij.GoLspConfigurable"
                                 instance="com.github.pocikode.go_lsp_intellij.GoLspConfigurable" />
        <actionOnSaveInfoProvider id="GoLspFormatOnSaveInfoProvider"
                                   implementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSaveInfoProvider" />
        <actionOnSave id="GoLspFormatOnSave"
                       implementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSave" />
        <notificationGroup id="Go LSP" displayType="BALLOON" />
    </extensions>
</idea-plugin>
