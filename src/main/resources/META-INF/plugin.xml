<idea-plugin>
    <id>dev.go-lsp</id>
    <name>Go LSP</name>
    <vendor url="https://github.com/agus/go-lsp-intellij">Go LSP contributors</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.go_lsp.intellij.GoLspSettingsState" />
        <applicationConfigurable parentId="tools" displayName="Go LSP"
                                 instance="dev.go_lsp.intellij.GoLspConfigurable" />
        <notificationGroup id="Go LSP" displayType="BALLOON" />
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="go-lsp" name="Go Language Server"
                factoryClass="dev.go_lsp.intellij.GoLanguageServerFactory">
            <description><![CDATA[
                <p>Go language support backed by the installed <code>gopls</code> language server.</p>
            ]]></description>
        </server>
        <!-- Keep the bundled TextMate Go grammar active; a custom LanguageFileType would disable it. -->
        <fileNamePatternMapping patterns="*.go" serverId="go-lsp" languageId="go"
                                documentMatcher="dev.go_lsp.intellij.GoDocumentMatcher" />
        <lang.foldingBuilder language="textmate"
                             implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"
                             order="first" />
        <codeInsight.parameterInfo language="textmate"
                                   implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler" />
        <lang.psiStructureViewFactory language="textmate"
                                      implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory" />
    </extensions>

    <actions>
        <action id="GoLsp.RestartServer" class="dev.go_lsp.intellij.RestartGoLspAction"
                text="Restart Go Language Server" description="Restart gopls for the current project">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>
