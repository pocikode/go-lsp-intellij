<idea-plugin>
    <id>com.github.pocikode.go_lsp_intellij</id>
    <name>Go LSP</name>
    <vendor url="https://github.com/pocikode/go-lsp-intellij">Go LSP contributors</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!--
        The IntelliJ LSP API ships in the IntelliJ IDEA (Ultimate) distribution and, since 2025.2,
        works without a paid license. The dependency is optional so the plugin still installs in
        builds without the module (Community 2025.2, Android Studio); only the gofmt/goimports
        format-on-save action works there. Everything that touches com.intellij.platform.lsp lives
        in go-lsp.xml.
    -->
    <depends optional="true" config-file="go-lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.pocikode.go_lsp_intellij.GoLspSettingsState" />
        <projectService serviceImplementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSaveState" />
        <applicationConfigurable parentId="tools" displayName="Go LSP"
                                 id="com.github.pocikode.go_lsp_intellij.GoLspConfigurable"
                                 instance="com.github.pocikode.go_lsp_intellij.GoLspConfigurable" />
        <actionOnSaveInfoProvider id="GoLspFormatOnSaveInfoProvider"
                                   implementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSaveInfoProvider" />
        <actionOnSave id="GoLspFormatOnSave"
                       implementation="com.github.pocikode.go_lsp_intellij.GoFormatOnSave" />
        <notificationGroup id="Go LSP" displayType="BALLOON" />
        <!-- Go files are handled by the bundled TextMate grammar, whose icon does not look like
             GoLand's; this restores a Go icon in the project view and editor tabs. -->
        <fileIconProvider implementation="com.github.pocikode.go_lsp_intellij.GoLspFileIconProvider" />
        <!--
            GoLand's Go colour keys carry explicit values for these two scheme families that no
            fallback key reproduces; without them package qualifiers and type references come out
            plain here while GoLand shows them olive and teal. A scheme that names a key itself
            still wins over these defaults. See GoLspSemanticTokens.
        -->
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/GoLspDarcula.xml" />
        <additionalTextAttributes scheme="IntelliJ Light" file="colorSchemes/GoLspLight.xml" />
        <!--
            Struct tag keys, which GoLand paints apart from the rest of the raw string. Registered
            for the TextMate language because that is what claims .go files without the native Go
            plugin; with that plugin loaded the files are not TextMate and this never runs.
        -->
        <annotator language="textmate"
                   implementationClass="com.github.pocikode.go_lsp_intellij.GoLspStructTagAnnotator" />
        <!--
            Makes *_test.go a member of the platform's built-in "Tests" scope, which File Colors
            already paints green; Go has no test source root for the platform to find by itself.
        -->
        <testSourcesFilter implementation="com.github.pocikode.go_lsp_intellij.GoLspTestSourcesFilter" />
    </extensions>
</idea-plugin>
